# ============================================================================
# SUPABASE — Variáveis de ambiente do projeto
# ============================================================================
# Copie este arquivo para .env e preencha com os valores do seu projeto Supabase
# Painel do Supabase: https://supabase.com/dashboard → Settings → API
# ============================================================================

# URL do seu projeto Supabase (encontrada em Project Settings → API)
VITE_SUPABASE_URL=https://umdfmsdrqwenddqrfafm.supabase.co

# Chave anônima (anon key) — é a chave pública, segura para uso no frontend
# Encontrada em Project Settings → API → Project API Keys → anon public
VITE_SUPABASE_ANON_KEY=sb_publishable_UWmYqON03Fw25oZOGjACCQ_t44d0oK7

# ============================================================================
# EDGE FUNCTIONS — Variáveis para o servidor Supabase (não para o frontend)
# ============================================================================
# Estas variáveis devem ser configuradas no painel do Supabase:
# Dashboard → Edge Functions → Secrets
#
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
#
# ============================================================================
# GOOGLE OAuth — Configuração do provedor Google
# ============================================================================
# 1. Acesse: https://console.cloud.google.com → APIs & Services → Credentials
# 2. Crie um OAuth 2.0 Client ID (Web application)
# 3. Adicione a URL de redirecionamento:
#    https://seu-projeto.supabase.co/auth/v1/callback
# 4. No Supabase: Authentication → Providers → Google
#    Ative o provedor e cole o Client ID e Client Secret
# ============================================================================
